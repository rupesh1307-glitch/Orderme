PORT=5000
NODE_ENV=development
# Generate a unique secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit your real .env file or reuse this placeholder in production.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_bytes
JWT_EXPIRES_IN=7d
DB_PATH=./data/orderme.db
